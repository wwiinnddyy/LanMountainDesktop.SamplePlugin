<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <OutputPath>bin\$(Configuration)\$(TargetFramework)\content\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <LanMountainAirAppBuildOutputDirectory>$(OutputPath)</LanMountainAirAppBuildOutputDirectory>
    <LanMountainAirAppPackageVersion>$(Version)</LanMountainAirAppPackageVersion>
    <LanMountainAirAppPackageOutputDirectory>$(MSBuildThisFileDirectory)</LanMountainAirAppPackageOutputDirectory>
    <LanMountainAirAppPackageFileName>$(AssemblyName).$(LanMountainAirAppPackageVersion)$(LanMountainAirAppPackageExtension)</LanMountainAirAppPackageFileName>
    <LanMountainAirAppPackagePath>$(LanMountainAirAppPackageOutputDirectory)$(LanMountainAirAppPackageFileName)</LanMountainAirAppPackagePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LanMountainDesktop.AirAppSdk" Version="1.0.0" ExcludeAssets="runtime;native" PrivateAssets="all" />
    <PackageReference Include="LanMountainDesktop.SharedContracts.SampleClock" Version="2.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    
    <None Include="Localization\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CleanPluginOutputBeforeBuild"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\content" />
  </Target>

</Project>
